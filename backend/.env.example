# =================================================================
# ProEduVate Backend Environment Variables (.env.example)
# Copy this file to .env and fill in your actual credentials.
# =================================================================

# --- MongoDB (REQUIRED) ---
# Connection string for MongoDB Atlas (or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# --- Google Gemini AI (REQUIRED) ---
# API key for Gemini AI - used for chatbot, ATS analysis, GD evaluation, etc.
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Authentication & Sessions (REQUIRED) ---
# Secret key used for signing JWT tokens and Flask sessions
JWT_SECRET=your_jwt_secret_key_here
SECRET_KEY=your_flask_secret_key_here

# --- Speech-to-Text / Whisper Configuration (OPTIONAL) ---
# Device: 'cpu' or 'cuda' | Compute type: 'int8', 'float16', or 'auto'
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- OpenAI (OPTIONAL - for GD AI agents fallback) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- AWS Lambda Execution (OPTIONAL - for remote code execution) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_LAMBDA_FUNCTION_NAME=
