# =================================================================
# ProEduVate Backend Environment Variables (.env.example)
# Copy this file to .env and fill in your actual credentials.
# =================================================================

# --- MongoDB (REQUIRED) ---
# Connection string for MongoDB Atlas (or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# --- Google Gemini AI (REQUIRED) ---
# API key for Gemini AI - used for chatbot, ATS analysis, GD evaluation, etc.
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Authentication & Sessions (REQUIRED) ---
# Secret key used for signing JWT tokens and Flask sessions
JWT_SECRET=your_jwt_secret_key_here
SECRET_KEY=your_flask_secret_key_here

# --- Local Ollama LLM (OPTIONAL - AI Interview question generation) ---
# OLLAMA_BASE_URL: where the local Ollama server listens (default below).
# OLLAMA_MODEL: model tag to use (e.g. llama3.2:3b, llama3.1:8b, qwen2.5:7b).
# OLLAMA_TIMEOUT_SECONDS: max wait for one generation (LLMs on CPU are slow).
# When Ollama is unreachable, question generation falls back to Gemini, then
# to an offline resume-grounded generator.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# --- Speech-to-Text / Whisper Configuration (OPTIONAL) ---
# Device: 'cpu' or 'cuda' | Compute type: 'int8', 'float16', or 'auto'
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- OpenAI (OPTIONAL - for GD AI agents fallback) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- AWS Lambda Execution (OPTIONAL - for remote code execution) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_LAMBDA_FUNCTION_NAME=
